# Telegram
TG_DASHBOARD_BOT_TOKEN=
TG_DASHBOARD_DRY_RUN_CHAT_ID=
TG_AGENT_ALLOWED_USER_IDS=
TG_AGENT_ALLOWED_CHAT_IDS=

# Bot identity
TG_AGENT_DISPLAY_NAME=TG Bot Agent
TG_AGENT_PROJECT_NAME=Client Project
TG_DASHBOARD_BASE_URL=https://example.com/dashboard/
TG_DASHBOARD_DATA_DIR=./data/dashboard

# Brain / Codex
TG_AGENT_BRAIN_ENABLED=0
TG_AGENT_BRAIN_COMMAND=codex exec --skip-git-repo-check --output-last-message {output} -

# High-quality voice replies
OPENAI_API_KEY=
TG_AGENT_TTS_PROVIDER=openai
TG_AGENT_TTS_MODEL=gpt-4o-mini-tts
TG_AGENT_TTS_VOICE=nova
TG_AGENT_TTS_FALLBACK=0

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=
CLICKUP_LIST_NAME=Main
CLICKUP_TELEGRAM_USER_MAP=

# Optional Google Sheets source for defect / waste checks
TG_FLOWERS_WASTE_SPREADSHEET_ID=
TG_FLOWERS_WASTE_JOURNAL_GID=
TG_FLOWERS_WASTE_SUMMARY_GID=
TG_FLOWERS_WASTE_URL=

# Optional LMS / external product source
TG_LMS_HOST=
TG_LMS_SSH_PORT=22
TG_LMS_SSH_KEY=
TG_LMS_CONTAINER=
TG_LMS_SITE=
TG_LMS_URL=
TG_LMS_DASHBOARD_METHOD=

# Optional Sheets webhook for saved notes
TG_AGENT_SHEETS_WEBHOOK_URL=
TG_AGENT_SHEETS_SECRET=
