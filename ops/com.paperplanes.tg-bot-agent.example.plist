<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paperplanes.tg-bot-agent</string>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/tg-bot-agent-starter-kit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>set -a; source .env; set +a; python3 scripts/tg_bot_agent.py --config data/tg_bot_agent.config.example.json run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/tg-bot-agent-starter-kit/data/tg_agent_logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/tg-bot-agent-starter-kit/data/tg_agent_logs/launchd.err.log</string>
</dict>
</plist>
